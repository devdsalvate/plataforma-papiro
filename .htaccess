# Papiro Máximo — Apache (XAMPP / InfinityFree)
Options -Indexes

# Bloqueia arquivos sensíveis
<FilesMatch "^(config\.local\.php|.*\.sqlite.*|.*\.sql|.*\.lock)$">
  Require all denied
</FilesMatch>

# Cache de assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
